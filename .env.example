STORE_KASPI_PHONE="+7 778 736 78 50"
STORE_KASPI_RECIPIENT="Айдын Б."
STORE_ADMIN_LOGIN=Admin1601
STORE_ADMIN_EMAIL=admin@zharzhar.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
